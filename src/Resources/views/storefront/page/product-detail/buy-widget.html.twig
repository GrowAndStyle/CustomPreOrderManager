{% sw_extends '@Storefront/storefront/page/product-detail/buy-widget.html.twig' %}

{% block page_product_detail_buy_inner %}
    {{ parent() }}

    {% set currentProduct = page.product|default(product|default(null)) %}
    {% set isPreOrder = currentProduct.customFields.custom_preorder_active|default(false) %}
    {% set hasStock = currentProduct.stock > 0 %}
    {% set inboundStock = currentProduct.customFields.custom_preorder_inbound_stock|default(0) %}
    {% set soldCount = currentProduct.customFields.custom_preorder_sold_count|default(0) %}
    {% set remainingQuota = inboundStock - soldCount %}

    {% if isPreOrder and not hasStock and inboundStock > 0 and remainingQuota <= 0 %}
        {% sw_include '@CustomPreOrderManager/storefront/component/preorder/waitlist-modal.html.twig' with { product: currentProduct } %}
    {% endif %}
{% endblock %}
