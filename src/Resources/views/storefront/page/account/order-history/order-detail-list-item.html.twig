{% sw_extends '@Storefront/storefront/page/account/order-history/order-detail-list-item.html.twig' %}

{% block page_account_order_item_detail_line_item_label %}
    {{ parent() }}

    {% if lineItem.payload.isPreOrder %}
        {% set releaseDate = lineItem.payload.preOrderReleaseDate %}
        {% set releaseNotice = lineItem.payload.preOrderNotice %}
        {% set legacyText = lineItem.payload.preOrderReleaseText %}

        <div class="line-item-preorder-info order-detail-preorder-info">
            <div class="line-item-preorder-badge-row">
                <span class="line-item-preorder-pill">
                    <span class="preorder-pulse-dot" aria-hidden="true"></span>
                    <span class="line-item-preorder-pill-text">{{ "custom-preorder.badge.preOrder"|trans }}</span>
                </span>

                <span class="line-item-preorder-status">
                    {% if releaseDate %}
                        {{ "custom-preorder.badge.availableFrom"|trans({'%date%': releaseDate}) }}
                    {% elseif legacyText %}
                        {{ legacyText }}
                    {% else %}
                        {{ "custom-preorder.badge.preOrder"|trans }}
                    {% endif %}
                </span>
            </div>

            {% if releaseDate and releaseNotice %}
                <div class="line-item-preorder-notice">
                    <svg class="line-item-notice-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    <span class="line-item-notice-text">{{ releaseNotice }}</span>
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
