{% sw_extends '@Storefront/storefront/component/product/card/box-standard.html.twig' %}

{#
 # Listing-Overlays: Date-Banner + Scarcity-Badge als echte Overlays im product-image-wrapper
 # Verankerung: component_product_box_image_inner (offiziell verifiziert, Shopware Core)
 # .product-image-wrapper hat position: relative via base.scss (ADR-011)
 # Kein Pixel-Hack, kein extra Wrapper — korrekter Containing Block
 #}
{% block component_product_box_image_inner %}
    {{- parent() -}}

    {% set isPreOrder = product.translated.customFields.custom_preorder_active
        |default(product.customFields.custom_preorder_active|default(false))
        or (product.translated.customFields.custom_preorder_release_date is defined
            and product.translated.customFields.custom_preorder_release_date is not empty) %}
    {% set hasStock = product.stock > 0 %}
    {% set enableBadge = config('CustomPreOrderManager.config.enableListingBadge') %}

    {% if isPreOrder and not hasStock and enableBadge %}
        {% set releaseDate = product.translated.customFields.custom_preorder_release_date
            |default(product.customFields.custom_preorder_release_date) %}

        {# Date-Banner: position absolute top: 0, relativ zu .product-image-wrapper #}
        {% if releaseDate %}
            <div class="product-preorder-date-banner" aria-hidden="true">
                <span class="preorder-banner-prefix">
                    {{ "custom-preorder.listing.availableFromPrefix"|trans }}
                </span>
                <span class="preorder-banner-date">
                    {{ releaseDate|date('d.m.Y') }}
                </span>
            </div>
        {% endif %}

        {# Scarcity-Badge: UWG-konform (ADR-010), position absolute bottom: 0 #}
        {# Config-Gate: scarcityDisplayMode — Shopbetreiber steuert Sichtbarkeit #}
        {% set scarcityMode = config('CustomPreOrderManager.config.scarcityDisplayMode') %}
        {% if scarcityMode == 'listing_only' or scarcityMode == 'everywhere' %}
            {% set inboundStock = product.translated.customFields.custom_preorder_inbound_stock
                |default(product.customFields.custom_preorder_inbound_stock|default(0)) %}
            {% set soldCount = product.translated.customFields.custom_preorder_sold_count
                |default(product.customFields.custom_preorder_sold_count|default(0)) %}
            {% set remaining = inboundStock - soldCount %}
            {% set rawThreshold = config('CustomPreOrderManager.config.lowStockThreshold') %}
            {% set threshold = (rawThreshold is not empty and rawThreshold > 0) ? rawThreshold : 5 %}

            {% if remaining > 0 and remaining <= threshold %}
                <span class="preorder-scarcity-listing"
                      aria-label="{{ 'custom-preorder.badge.urgentFewLeft'|trans({'%count%': remaining})|striptags }}">
                    {{ "custom-preorder.badge.urgentFewLeft"|trans({'%count%': remaining}) }}
                </span>
            {% endif %}
        {% endif %}
    {% endif %}
{% endblock %}
