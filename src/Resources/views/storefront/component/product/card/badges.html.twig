{% sw_extends '@Storefront/storefront/component/product/card/badges.html.twig' %}

{#
 # Nur semantisches Text-Badge (§1.C Skill) — kein Bild-Overlay mehr.
 # Date-Banner + Scarcity-Badge liegen in box-standard.html.twig (ADR-011).
 # Gate: enableListingBadge — ein Toggle für alle Listing-Pre-Order-UI
 #}
{% block component_product_badges %}
    {{ parent() }}

    {% set isPreOrder = product.customFields.custom_preorder_active|default(false) or
        (product.translated.customFields.custom_preorder_release_date is defined and
         product.translated.customFields.custom_preorder_release_date is not empty) %}
    {% set hasStock = product.stock > 0 %}

    {% if isPreOrder and not hasStock and config('CustomPreOrderManager.config.enableListingBadge') %}
        <span class="badge badge-preorder">
            {{ "custom-preorder.badge.preOrder"|trans }}
        </span>
    {% endif %}
{% endblock %}
