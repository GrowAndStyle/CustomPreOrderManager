{% sw_extends '@Storefront/storefront/component/product/card/badges.html.twig' %}

{% block component_product_badges %}
    {{ parent() }}

    {% set isPreOrder = product.customFields.custom_preorder_active|default(false) or
        (product.translated.customFields.custom_preorder_release_date is defined and
         product.translated.customFields.custom_preorder_release_date is not empty) %}
    {% set hasStock = product.stock > 0 %}

    {% if isPreOrder and not hasStock %}
        {% set releaseDate = product.translated.customFields.custom_preorder_release_date
            |default(product.customFields.custom_preorder_release_date) %}

        {% if releaseDate %}
            <div class="product-preorder-date-banner">
                <span class="preorder-banner-prefix">
                    {{ "custom-preorder.listing.availableFromPrefix"|trans }}
                </span>
                <span class="preorder-banner-date">
                    {{ releaseDate|date('d.m.Y') }}
                </span>
            </div>
        {% endif %}

        {# Scarcity-Badge: UWG-konform, direkt inline (ADR-010) — kein sw_include,
           da @CustomPreOrderManager-Namespace nicht in der @Storefront Theme-Chain liegt #}
        {% set scarcityMode = config('CustomPreOrderManager.config.scarcityDisplayMode') %}
        {% if scarcityMode == 'listing_only' or scarcityMode == 'everywhere' %}
            {% set inboundStock = product.translated.customFields.custom_preorder_inbound_stock
                |default(product.customFields.custom_preorder_inbound_stock|default(0)) %}
            {% set soldCount = product.translated.customFields.custom_preorder_sold_count
                |default(product.customFields.custom_preorder_sold_count|default(0)) %}
            {% set remaining = inboundStock - soldCount %}
            {% set rawThreshold = config('CustomPreOrderManager.config.lowStockThreshold') %}
            {% set threshold = (rawThreshold is not empty and rawThreshold > 0) ? rawThreshold : 5 %}

            {% if remaining > 0 and remaining <= threshold %}
                <span class="preorder-scarcity-listing">
                    {{ "custom-preorder.badge.urgentFewLeft"|trans({'%count%': remaining}) }}
                </span>
            {% endif %}
        {% endif %}
    {% endif %}
{% endblock %}
