{% sw_extends '@Storefront/storefront/component/checkout/offcanvas-cart.html.twig' %}

{% block component_offcanvas_cart_actions_checkout %}
    {% set hasPreOrder = false %}
    {% set hasRegular = false %}

    {% for lineItem in page.cart.lineItems %}
        {% if lineItem.type == 'product' %}
            {% if lineItem.payload.isPreOrder %}
                {% set hasPreOrder = true %}
            {% else %}
                {% set hasRegular = true %}
            {% endif %}
        {% endif %}
    {% endfor %}

    {% set isMixedCart = hasPreOrder and hasRegular %}

    {% if isMixedCart and config('CustomPreOrderManager.config.enableMixedCartNotice') %}
        {% set noticeMode = config('CustomPreOrderManager.config.mixedCartNoticeMode')|default('flexible') %}
        <div class="mixed-cart-notice">
            <div class="mixed-cart-notice-headline">
                <svg class="mixed-cart-notice-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span class="mixed-cart-notice-title">{{ "custom-preorder.cart.mixedCartBadge"|trans }}</span>
            </div>
            <div class="mixed-cart-notice-body">
                {% if noticeMode == 'split' %}
                    {{ "custom-preorder.cart.mixedCartSplit"|trans }}
                {% elseif noticeMode == 'consolidated' %}
                    {{ "custom-preorder.cart.mixedCartConsolidated"|trans }}
                {% elseif noticeMode == 'custom' %}
                    {{ config('CustomPreOrderManager.config.mixedCartCustomNoticeText')|default("custom-preorder.cart.mixedCartFlexible"|trans) }}
                {% else %}
                    {{ "custom-preorder.cart.mixedCartFlexible"|trans }}
                {% endif %}
            </div>
        </div>
    {% endif %}

    {{ parent() }}
{% endblock %}
