<div class="modal fade"
     id="preorderWaitlistModal"
     tabindex="-1"
     aria-labelledby="preorderWaitlistModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="preorderWaitlistModalLabel">
                    {{ "custom-preorder.waitlist.modalTitle"|trans }}
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <form action="{{ app.request.baseUrl }}/preorder/waitlist/subscribe"
                  method="post"
                  data-preorder-waitlist-form="true">
                <div class="modal-body">
                    {{ sw_csrf('frontend.preorder.waitlist.subscribe') }}
                    <input type="hidden" name="productId" value="{{ product.id }}">
                    <input type="text" name="hp_check" style="display:none !important;" tabindex="-1" autocomplete="off">

                    <p class="text-muted mb-3">
                        <strong>{{ product.translated.name|default(product.name) }}</strong>
                    </p>

                    <div class="mb-3">
                        <label for="preorderWaitlistName" class="form-label">
                            {{ "custom-preorder.waitlist.namePlaceholder"|trans }}
                        </label>
                        <input type="text"
                               class="form-control"
                               id="preorderWaitlistName"
                               name="name"
                               placeholder="{{ "custom-preorder.waitlist.namePlaceholder"|trans }}">
                    </div>

                    <div class="mb-3">
                        <label for="preorderWaitlistEmail" class="form-label">
                            {{ "custom-preorder.waitlist.emailPlaceholder"|trans }} <span class="text-danger">*</span>
                        </label>
                        <input type="email"
                               class="form-control"
                               id="preorderWaitlistEmail"
                               name="email"
                               required
                               placeholder="{{ "custom-preorder.waitlist.emailPlaceholder"|trans }}">
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               value="1"
                               id="preorderWaitlistConsent"
                               name="consent"
                               required>
                        <label class="form-check-label small" for="preorderWaitlistConsent">
                            {{ "custom-preorder.waitlist.consentText"|trans }}
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Abbrechen
                    </button>
                    <button type="submit" class="btn btn-primary btn-preorder-submit">
                        {{ "custom-preorder.waitlist.submit"|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
