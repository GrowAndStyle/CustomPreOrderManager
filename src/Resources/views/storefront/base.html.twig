{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_head %}
    {{ parent() }}

    {% set btnBg = config('CustomPreOrderManager.config.buttonBackgroundColor')|trim|replace({';': '', '"': '', "'": '', '<': '', '>': '', '{': '', '}': ''})|default('#1a1a2e') %}
    {% set btnHoverBg = config('CustomPreOrderManager.config.buttonHoverBackgroundColor')|trim|replace({';': '', '"': '', "'": '', '<': '', '>': '', '{': '', '}': ''})|default('#2b2b48') %}
    {% set btnColor = config('CustomPreOrderManager.config.buttonTextColor')|trim|replace({';': '', '"': '', "'": '', '<': '', '>': '', '{': '', '}': ''})|default('#ffffff') %}
    {% set btnHoverColor = config('CustomPreOrderManager.config.buttonHoverTextColor')|trim|replace({';': '', '"': '', "'": '', '<': '', '>': '', '{': '', '}': ''})|default('#ffffff') %}
    {% set btnBorder = config('CustomPreOrderManager.config.buttonBorderColor')|trim|replace({';': '', '"': '', "'": '', '<': '', '>': '', '{': '', '}': ''})|default('#1a1a2e') %}
    {% set btnHoverBorder = config('CustomPreOrderManager.config.buttonHoverBorderColor')|trim|replace({';': '', '"': '', "'": '', '<': '', '>': '', '{': '', '}': ''})|default('#2b2b48') %}

    {% set cardRadius = config('CustomPreOrderManager.config.cardBorderRadius')|default(12) %}
    {% set cardBg = config('CustomPreOrderManager.config.cardBackgroundColor')|trim|replace({';': '', '"': '', "'": '', '<': '', '>': '', '{': '', '}': ''})|default('#f8fafc') %}
    {% set cardBorder = config('CustomPreOrderManager.config.cardBorderColor')|trim|replace({';': '', '"': '', "'": '', '<': '', '>': '', '{': '', '}': ''})|default('#e2e8f0') %}
    {% set cardAccent = config('CustomPreOrderManager.config.cardAccentColor')|trim|replace({';': '', '"': '', "'": '', '<': '', '>': '', '{': '', '}': ''})|default('#e67e22') %}
    {% set cardColor = config('CustomPreOrderManager.config.cardTextColor')|trim|replace({';': '', '"': '', "'": '', '<': '', '>': '', '{': '', '}': ''})|default('#0f172a') %}
    {% set cardShadow = config('CustomPreOrderManager.config.cardEnableShadow') %}
    {% set cardGradient = config('CustomPreOrderManager.config.cardEnableGradient') %}

    {% set bannerBg = config('CustomPreOrderManager.config.listingBannerBackgroundColor')|trim|replace({';': '', '"': '', "'": '', '<': '', '>': '', '{': '', '}': ''})|default('#0f172a') %}
    {% set bannerColor = config('CustomPreOrderManager.config.listingBannerTextColor')|trim|replace({';': '', '"': '', "'": '', '<': '', '>': '', '{': '', '}': ''})|default('#ffffff') %}
    {% set bannerOpacityRaw = config('CustomPreOrderManager.config.listingBannerOpacity')|default(55) %}
    {% set bannerOpacity = (bannerOpacityRaw < 20 ? 20 : (bannerOpacityRaw > 100 ? 100 : bannerOpacityRaw)) / 100 %}

    <style>
        :root {
            --custom-preorder-btn-bg: {{ btnBg }};
            --custom-preorder-btn-hover-bg: {{ btnHoverBg }};
            --custom-preorder-btn-color: {{ btnColor }};
            --custom-preorder-btn-hover-color: {{ btnHoverColor }};
            --custom-preorder-btn-border: {{ btnBorder }};
            --custom-preorder-btn-hover-border: {{ btnHoverBorder }};

            --custom-preorder-card-radius: {{ cardRadius }}px;
            --custom-preorder-card-bg: {{ cardBg }};
            --custom-preorder-card-border: {{ cardBorder }};
            --custom-preorder-card-accent: {{ cardAccent }};
            --custom-preorder-card-color: {{ cardColor }};
            --custom-preorder-card-shadow: {{ (cardShadow is null or cardShadow == true) ? '0 1px 3px rgba(15, 23, 42, 0.04), 0 6px 16px -4px rgba(15, 23, 42, 0.06)' : 'none' }};
            --custom-preorder-card-bg-render: {{ (cardGradient is null or cardGradient == true) ? ('linear-gradient(135deg, #ffffff 0%, ' ~ cardBg ~ ' 100%)') : cardBg }};

            --custom-preorder-banner-bg: {{ bannerBg }};
            --custom-preorder-banner-color: {{ bannerColor }};
            --custom-preorder-banner-opacity: {{ bannerOpacity }};
        }
    </style>
{% endblock %}
