        "description": {
            "de-DE": "Autarkes Vorbestellungs-System mit Scarcity-Engine für Shopware 6",
            "en-GB": "Self-contained pre-order system with scarcity engine for Shopware 6"
        }
    },
    "require": {
        "shopware/core": "~6.5.8.0 || ^6.6.0 || ^6.7.0"
    }
}
