{
    "name": "growandstyle/custom-pre-order-manager",
    "description": "Autarkes Vorbestellungs-System für Shopware 6",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "GrowAndStyle",
            "homepage": "https://growandstyle.de"
        }
    ],
    "autoload": {
        "psr-4": {
            "CustomPreOrderManager\\": "src/"
        }
    },
    "extra": {
        "shopware-plugin-class": "CustomPreOrderManager\\CustomPreOrderManager",
        "label": {
            "de-DE": "Vorbestellung (Pre-Order)",
            "en-GB": "Pre-Order"
